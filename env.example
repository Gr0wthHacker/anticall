# CallShield Network - example environment. Copy to .env (cp env.example .env). NEVER commit .env.
# All risky capabilities default to false. Enabling any of them requires the
# gates in docs/legal/release-gates.md to have passed for your deployment.

# --- Core ---
CALLSHIELD_ENV=dev                       # dev | prod
CALLSHIELD_LOG_LEVEL=INFO
CALLSHIELD_DATABASE_URL=postgresql+psycopg://callshield:CHANGE_ME@postgres:5432/callshield
CALLSHIELD_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
CALLSHIELD_JWT_ISSUER=callshield-local
# Browser origins allowed to call the API (CORS). JSON list. Empty/unset = no CORS headers.
# Explicit origins only: "*" is refused. Auth is a bearer header, so credentials are never allowed.
CALLSHIELD_CORS_ALLOW_ORIGINS=["http://127.0.0.1:3000"]
# Replay-nonce retention for the webhook.purge_receipts job (days, >= 1).
CALLSHIELD_WEBHOOK_RECEIPT_RETENTION_DAYS=30
# An UNKNOWN filing older than this many hours asks the user to verify it (needs_user_verification).
CALLSHIELD_FILING_UNKNOWN_VERIFY_AFTER_HOURS=24

# Postgres container (compose)
POSTGRES_USER=callshield
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=callshield

# --- Risky capabilities (all disabled by default) ---
CALLSHIELD_TELEPHONY_ENABLED=false           # real SIP/provider events
CALLSHIELD_OUTBOUND_CALLING_ENABLED=false    # any outbound call
CALLSHIELD_AI_AGENT_ENABLED=false            # AI conversation on calls
CALLSHIELD_LIVE_STT_ENABLED=false            # live speech processing
CALLSHIELD_RECORDING_ENABLED=false           # persist audio
CALLSHIELD_TRANSCRIPTION_PERSIST_ENABLED=false
CALLSHIELD_REMOTE_AI_ENABLED=false           # send media/text to remote AI vendors
CALLSHIELD_AGENCY_SUBMISSION_ENABLED=false   # programmatic agency filing (manual handoff only when false)
CALLSHIELD_COMMUNITY_ENABLED=false           # opt-in community sharing
CALLSHIELD_TELEMETRY_ENABLED=false           # no telemetry exists; keep false

# --- Policy limits (used only if outbound is ever enabled) ---
CALLSHIELD_OUTBOUND_MAX_SESSION_SECONDS=180
CALLSHIELD_OUTBOUND_COOLDOWN_SECONDS=86400
CALLSHIELD_OUTBOUND_MAX_ATTEMPTS_PER_CASE_PER_DAY=1

# --- Asterisk / ARI (R0 harness only; placeholders) ---
CALLSHIELD_ARI_URL=http://asterisk:8088/ari
CALLSHIELD_ARI_USER=callshield
CALLSHIELD_ARI_PASSWORD=CHANGE_ME
CALLSHIELD_WEBHOOK_SIGNING_SECRET=CHANGE_ME

# --- Optional Redis (compose profile "redis") ---
CALLSHIELD_REDIS_URL=

# --- Evidence storage ---
CALLSHIELD_EVIDENCE_STORAGE_DIR=/var/lib/callshield/evidence

# --- Retention design defaults (days) ---
CALLSHIELD_RETENTION_METADATA_DAYS=90
CALLSHIELD_RETENTION_RECORDINGS_DAYS=30
CALLSHIELD_RETENTION_TRANSCRIPTS_DAYS=30
CALLSHIELD_RETENTION_CASES_DAYS=365
CALLSHIELD_RETENTION_LOGS_DAYS=14

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
