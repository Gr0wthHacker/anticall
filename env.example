# CallShield Network environment.
# Keep this file private (chmod 600) and NEVER commit it.
# Every risky capability is OFF by default. Turning one on does not make it lawful:
# see docs/legal/release-gates.md and docs/deployment/going-live-checklist.md.


# ===== Settings =====
# Deployment mode: dev, test or prod.
#   (default: dev; changed by: operator (.env))
CALLSHIELD_ENVIRONMENT=dev
# SQLAlchemy database URL. SQLite for local use, Postgres for real.
#   (default: sqlite:///./callshield.db; changed by: operator (.env))
CALLSHIELD_DB_URL=sqlite:///./callshield.db
# Log SQL statements (debug only; may expose data).
#   (default: false; range: true/false; changed by: operator (.env))
CALLSHIELD_DB_ECHO=false
# Master switch for any outbound call.
#   (default: false; range: true/false; gate: G1,G2,G4,G5; changed by: operator (.env))
CALLSHIELD_OUTBOUND_ENABLED=false
# Live speech-to-text on calls.
#   (default: false; range: true/false; gate: G3; changed by: operator (.env))
CALLSHIELD_LIVE_STT_ENABLED=false
# AI voice on outbound calls.
#   (default: false; range: true/false; gate: G1,G4,G5; changed by: operator (.env))
CALLSHIELD_AI_OUTBOUND_ENABLED=false
# Community signal sharing (not built).
#   (default: false; range: true/false; gate: counsel; changed by: operator (.env))
CALLSHIELD_COMMUNITY_ENABLED=false
# Programmatic agency filing.
#   (default: false; range: true/false; gate: counsel; changed by: operator (.env))
CALLSHIELD_FILING_SUBMISSION_ENABLED=false
# Signs login tokens. Must be random and private.
#   (default: insecure dev placeholder; changed by: operator (.env))
CALLSHIELD_JWT_SECRET=CHANGE_ME
# JWT signing algorithm.
#   (default: HS256; changed by: operator (.env))
CALLSHIELD_JWT_ALGORITHM=HS256
# Login token lifetime in seconds.
#   (default: 3600; changed by: operator (.env))
CALLSHIELD_ACCESS_TOKEN_TTL_SECONDS=3600
# Allow creating more tenants through the open endpoint.
#   (default: false; range: true/false; changed by: operator (.env))
CALLSHIELD_ALLOW_BOOTSTRAP=false
# OIDC issuer (not implemented).
#   (default: (unset); changed by: operator (.env))
# CALLSHIELD_OIDC_ISSUER=
# OIDC client id (not implemented).
#   (default: (unset); changed by: operator (.env))
# CALLSHIELD_OIDC_CLIENT_ID=
# OIDC client secret (not implemented).
#   (default: (unset); changed by: operator (.env))
# CALLSHIELD_OIDC_CLIENT_SECRET=
# HMAC secret that signs provider webhooks.
#   (default: (empty); changed by: operator (.env))
CALLSHIELD_WEBHOOK_SECRET=CHANGE_ME
# How old a signed webhook may be.
#   (default: 300; changed by: operator (.env))
CALLSHIELD_WEBHOOK_REPLAY_WINDOW_SECONDS=300
# Days to keep replay nonces.
#   (default: 30; range: 1-; changed by: operator (.env))
CALLSHIELD_WEBHOOK_RECEIPT_RETENTION_DAYS=30
# JSON list of browser origins allowed; never '*'.
#   (default: []; changed by: operator (.env))
CALLSHIELD_CORS_ALLOW_ORIGINS='["http://127.0.0.1:3000"]'
# Hours before an UNKNOWN filing asks you to verify it.
#   (default: 24; range: 1-; changed by: operator (.env))
CALLSHIELD_FILING_UNKNOWN_VERIFY_AFTER_HOURS=24
# Hard cap on a single call's length.
#   (default: 600; changed by: operator (.env))
CALLSHIELD_MAX_CALL_SECONDS=600
# Minimum gap between outbound attempts.
#   (default: 900; changed by: operator (.env))
CALLSHIELD_OUTBOUND_COOLDOWN_SECONDS=900
# Outbound attempts per case per day.
#   (default: 3; changed by: operator (.env))
CALLSHIELD_MAX_ATTEMPTS_PER_CASE_PER_DAY=3
# Outbound attempts per tenant per day.
#   (default: 10; changed by: operator (.env))
CALLSHIELD_MAX_ATTEMPTS_PER_TENANT_PER_DAY=10
# Retention for call metadata (design default).
#   (default: 90; changed by: operator (.env))
CALLSHIELD_RETENTION_METADATA_DAYS=90
# Retention for recordings (design default).
#   (default: 30; changed by: operator (.env))
CALLSHIELD_RETENTION_RECORDING_DAYS=30
# Retention for transcripts (design default).
#   (default: 30; changed by: operator (.env))
CALLSHIELD_RETENTION_TRANSCRIPT_DAYS=30
# Retention for cases (design default).
#   (default: 365; changed by: operator (.env))
CALLSHIELD_RETENTION_CASE_DAYS=365

# ===== CallbackSettings =====
# Enable the automated callback flow.
#   (default: false; range: true/false; gate: G1-G5; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_CALLBACK_ENABLED=false
# How long after an inbound call a callback may be requested.
#   (default: 72; range: 1-168; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_CALLBACK_WINDOW_HOURS=72
# Seconds of listening before disclosure.
#   (default: 10; range: 0-10; gate: G3; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_LISTEN_WINDOW_SECONDS=10
# Silence before disclosure after a bare greeting.
#   (default: 1500; range: 500-3000; changed by: operator)
CALLSHIELD_CALLBACK_BARE_GREETING_DISCLOSE_MS=1500
# Callbacks per inbound call (ceiling 2).
#   (default: 2; range: 1-2; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_MAX_ATTEMPTS_PER_INBOUND=2
# Callbacks per number in 30 days (ceiling 2).
#   (default: 2; range: 1-2; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_MAX_ATTEMPTS_PER_NUMBER_30D=2
# Callbacks per user per day (ceiling 5).
#   (default: 5; range: 1-5; changed by: user (dashboard), within range)
CALLSHIELD_CALLBACK_MAX_ATTEMPTS_PER_USER_DAY=5
# Scripted question turns per callback.
#   (default: 4; range: 1-4; changed by: operator)
CALLSHIELD_CALLBACK_MAX_QUESTION_TURNS=4
# Maximum callback duration.
#   (default: 120; range: 30-120; changed by: operator)
CALLSHIELD_CALLBACK_MAX_CALL_SECONDS=120
# Record callbacks (needs a recording notice).
#   (default: false; range: true/false; gate: G3; changed by: chosen per request)
CALLSHIELD_CALLBACK_OUTBOUND_RECORDING=false
# Locked to false: no remote AI on callbacks.
#   (default: false; range: locked: false; changed by: nobody (locked))
CALLSHIELD_CALLBACK_REMOTE_AI_PROCESSING=false
# Locked to A: only A-attested inbound calls.
#   (default: A; range: locked: A; gate: G2; changed by: nobody (locked))
CALLSHIELD_CALLBACK_ALLOWED_ATTESTATION=A
# Which built-in disclosure script is spoken.
#   (default: v1; changed by: operator (.env))
CALLSHIELD_CALLBACK_DISCLOSURE_TEMPLATE_ID=v1
# Key that signs callback authorizations.
#   (default: insecure dev placeholder; changed by: operator (.env))
CALLSHIELD_CALLBACK_HMAC_SECRET=CHANGE_ME
# Directory for callback artifacts.
#   (default: ./var/callback; changed by: operator (.env))
CALLSHIELD_CALLBACK_STORAGE_ROOT=./var/callback

# ===== LLMSettings =====
# Enable LLM classification/summaries.
#   (default: false; range: true/false; gate: G5; changed by: operator (.env))
CALLSHIELD_LLM_ENABLED=false
# OpenAI-compatible endpoint (prefer local).
#   (default: ""; changed by: operator (.env))
# CALLSHIELD_LLM_BASE_URL=
# Model name at that endpoint.
#   (default: ""; changed by: operator (.env))
# CALLSHIELD_LLM_MODEL=
# API key for the endpoint, if any.
#   (default: (unset); changed by: operator (.env))
# CALLSHIELD_LLM_API_KEY=
# Seconds before an LLM call is abandoned.
#   (default: 2.0; changed by: operator (.env))
CALLSHIELD_LLM_TIMEOUT_SECONDS=2.0

# ===== InstanceSettings =====
# Your jurisdiction code (e.g. US-CA), informational.
#   (default: UNKNOWN; changed by: operator (.env))
CALLSHIELD_INSTANCE_JURISDICTION=UNKNOWN
# IANA timezone for calling-hour checks.
#   (default: UTC; changed by: operator (.env))
CALLSHIELD_INSTANCE_TIMEZONE=UTC
# Provider profile id chosen in init.
#   (default: generic_sip; changed by: operator (.env))
CALLSHIELD_INSTANCE_PROVIDER_PROFILE=generic_sip
# Path of the generated pjsip snippet.
#   (default: ""; changed by: operator (.env))
# CALLSHIELD_INSTANCE_PJSIP_PATH=
# PJSIP trunk/endpoint name (used by doctor).
#   (default: ""; changed by: operator (.env))
# CALLSHIELD_INSTANCE_TRUNK_NAME=
# Free text: where your backups go (checked by doctor).
#   (default: ""; changed by: operator (.env))
# CALLSHIELD_INSTANCE_BACKUP_NOTE=

# ===== AriSettings =====
# Connect to Asterisk ARI.
#   (default: false; range: true/false; gate: G5; changed by: operator (.env))
CALLSHIELD_ARI_ENABLED=false
# ARI base URL. Keep it on localhost.
#   (default: http://127.0.0.1:8088/ari; changed by: operator (.env))
CALLSHIELD_ARI_URL=http://127.0.0.1:8088/ari
# ARI user.
#   (default: callshield; changed by: operator (.env))
CALLSHIELD_ARI_USERNAME=callshield
# ARI password; must equal ari.conf.
#   (default: (empty); changed by: operator (.env))
CALLSHIELD_ARI_PASSWORD=CHANGE_ME
# Stasis application name.
#   (default: callshield; changed by: operator (.env))
CALLSHIELD_ARI_APP=callshield

# ===== VoiceSettings =====
# Speech-to-text engine: none, vosk, faster-whisper.
#   (default: none; changed by: operator (.env))
CALLSHIELD_VOICE_STT_ENGINE=none
# Text-to-speech engine: none, piper.
#   (default: none; changed by: operator (.env))
CALLSHIELD_VOICE_TTS_ENGINE=none
# Directory holding downloaded voice models.
#   (default: ./var/models; changed by: operator (.env))
CALLSHIELD_VOICE_MODEL_DIR=./var/models

# ===== Docker compose / dashboard (not read by the API) =====
# Postgres container user (compose only).
POSTGRES_USER=callshield
# Postgres container password (compose only).
POSTGRES_PASSWORD=CHANGE_ME
# Postgres container database (compose only).
POSTGRES_DB=callshield
# Dashboard -> API URL (build time).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
